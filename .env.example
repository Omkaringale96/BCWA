# Environment Mode: 'development' or 'production'
FLASK_ENV=development
DEBUG=True
PORT=5000

# Flask Session Security Key
FLASK_SECRET_KEY=bcwa_portal_enterprise_security_key_2026

# Supabase Credentials (Obtain from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
SUPABASE_SERVICE_KEY=sb_secret_your_service_role_key_here

# Brevo SMTP Configuration (Obtain from Brevo Dashboard > SMTP & API Keys > SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=your_brevo_account_email
BREVO_SMTP_PASSWORD=xsmtpsib-your_brevo_smtp_key_here
