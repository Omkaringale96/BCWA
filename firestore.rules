rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        !('role' in request.auth.token) ||
        request.auth.token.role == 'SuperAdmin' ||
        request.auth.token.role == 'Admin' ||
        request.auth.token.role == 'AssociationAdmin' ||
        request.auth.token.role == 'Staff' ||
        request.auth.email == 'bhosalevinayakpsnl@gmail.com'
      );
    }

    function isStoreOwner(storeId) {
      return isAuthenticated() &&
        'role' in request.auth.token &&
        request.auth.token.role == 'StoreOwner' &&
        'store_id' in request.auth.token &&
        request.auth.token.store_id == storeId;
    }

    function isStoreOwnerForDoc() {
      return isAuthenticated() &&
        'role' in request.auth.token &&
        request.auth.token.role == 'StoreOwner' &&
        'store_id' in request.auth.token &&
        resource.data.store_id == request.auth.token.store_id;
    }

    function isStoreOwnerForNewDoc() {
      return isAuthenticated() &&
        'role' in request.auth.token &&
        request.auth.token.role == 'StoreOwner' &&
        'store_id' in request.auth.token &&
        request.resource.data.store_id == request.auth.token.store_id;
    }

    // Medical Stores Collection
    match /medical_stores/{storeId} {
      allow read: if isSuperAdmin() || isStoreOwner(storeId) || isStoreOwnerForDoc();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isStoreOwner(storeId) &&
        (!('id' in request.resource.data) || request.resource.data.id == resource.data.id)
      );
      allow delete: if isSuperAdmin();
    }

    match /stores/{storeId} {
      allow read: if isSuperAdmin() || isStoreOwner(storeId) || isStoreOwnerForDoc();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isStoreOwner(storeId);
      allow delete: if isSuperAdmin();
    }

    // Documents Collection
    match /documents/{docId} {
      allow read: if isSuperAdmin() || isStoreOwnerForDoc();
      allow create: if isSuperAdmin() || isStoreOwnerForNewDoc();
      allow update: if isSuperAdmin() || (
        isStoreOwnerForDoc() &&
        isStoreOwnerForNewDoc()
      );
      allow delete: if isSuperAdmin() || isStoreOwnerForDoc();
    }

    // Pharmacists Collection
    match /pharmacists/{phId} {
      allow read: if isSuperAdmin() || isStoreOwnerForDoc() || (
        isAuthenticated() && 'role' in request.auth.token && request.auth.token.role == 'StoreOwner'
      );
      allow create: if isSuperAdmin() || isStoreOwnerForNewDoc();
      allow update: if isSuperAdmin() || (isStoreOwnerForDoc() && isStoreOwnerForNewDoc());
      allow delete: if isSuperAdmin() || isStoreOwnerForDoc();
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // Store Accounts Collection
    match /store_accounts/{accId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && 'role' in request.auth.token && request.auth.token.role == 'StoreOwner' &&
        (resource.data.store_id == request.auth.token.store_id || resource.data.firm_id == request.auth.token.firm_id)
      );
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Other System Collections
    match /email_queue/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /email_logs/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /admin_users/{doc=**} { allow read, write: if isSuperAdmin(); }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
