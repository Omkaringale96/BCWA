rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'admin_vin2821' ||
        ('role' in request.auth.token && (
          request.auth.token.role == 'SuperAdmin' ||
          request.auth.token.role == 'Admin' ||
          request.auth.token.role == 'AssociationAdmin' ||
          request.auth.token.role == 'Staff'
        ))
      );
    }

    function isStoreOwner(storeId) {
      return isAuthenticated() &&
        'role' in request.auth.token &&
        request.auth.token.role == 'StoreOwner' &&
        'store_id' in request.auth.token &&
        request.auth.token.store_id == storeId;
    }

    function isStoreOwnerForDoc() {
      return isAuthenticated() &&
        'role' in request.auth.token &&
        request.auth.token.role == 'StoreOwner' &&
        'store_id' in request.auth.token &&
        resource.data.store_id == request.auth.token.store_id;
    }

    // Medical Stores Collection
    match /medical_stores/{storeId} {
      allow read: if isSuperAdmin() || isStoreOwner(storeId);
      allow create, update, delete: if isSuperAdmin();
    }

    match /stores/{storeId} {
      allow read: if isSuperAdmin() || isStoreOwner(storeId);
      allow create, update, delete: if isSuperAdmin();
    }

    // Documents Collection
    match /documents/{docId} {
      allow read: if isSuperAdmin() || isStoreOwnerForDoc();
      allow create: if isSuperAdmin() || (
        isAuthenticated() &&
        'role' in request.auth.token &&
        request.auth.token.role == 'StoreOwner' &&
        request.resource.data.store_id == request.auth.token.store_id
      );
      allow update, delete: if isSuperAdmin() || isStoreOwnerForDoc();
    }

    // Pharmacists Collection
    match /pharmacists/{phId} {
      allow read: if isSuperAdmin() || isStoreOwnerForDoc();
      allow create, update, delete: if isSuperAdmin();
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // Store Accounts Collection
    match /store_accounts/{accId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    // Other System Collections
    match /email_queue/{doc=**} { allow read, write: if isAuthenticated(); }
    match /email_logs/{doc=**} { allow read, write: if isAuthenticated(); }
    match /admin_users/{doc=**} { allow read, write: if isAuthenticated(); }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
